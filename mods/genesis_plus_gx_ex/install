config="$rootfs/etc/libretro/config"
kept=$(mktemp -d)
file="Genesis Plus GX/Paprium.bin.cfg"
if [ -f "$config/$file" ]; then
  mkdir -p "$kept/$(dirname "$file")"
  cp "$config/$file" "$kept/$file"
fi
transfer_default
cp -rf "$kept/." "$config/"
rm -rf "$kept"
return 1
