# shellcheck disable=SC2154
removeLine() {
  [ -f "$1" ] || return 0
  sed -i "/^$2 = \"$3\"\$/d" "$1"
  [ -s "$1" ] || rm -f "$1"
}

config_path="$rootfs/etc/libretro/config/PPSSPP"
removeLine "$config_path/PPSSPP.cfg" aspect_ratio_index 22
removeLine "$config_path/PPSSPP.opt" ppsspp_lower_resolution_for_effects Balanced
removeLine "$config_path/PPSSPP.opt" ppsspp_skip_gpu_readbacks enabled
rmdir "$config_path" 2> /dev/null
