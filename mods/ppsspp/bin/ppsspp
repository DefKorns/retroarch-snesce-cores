save_path=/var/saves
[ -d "$save_path" ] || save_path=/var/lib/clover/profiles/0
config_path=/etc/libretro/config/PPSSPP

ensureKey() {
  grep -q "^$2 " "$1" 2> /dev/null || printf '%s = "%s"\n' "$2" "$3" >> "$1"
}

mkdir -p "$save_path/PSP" "$config_path" /var/cache/retroarch
ln -nsf -T "$save_path/PSP" /var/cache/retroarch/PSP
ensureKey "$config_path/PPSSPP.cfg" aspect_ratio_index 22
ensureKey "$config_path/PPSSPP.opt" ppsspp_lower_resolution_for_effects Balanced
ensureKey "$config_path/PPSSPP.opt" ppsspp_skip_gpu_readbacks enabled
exec retroarch-clover ppsspp "$@" --ra-nosaves
