export CPUFLAGS="-mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard"
export CFLAGS="-I/opt/gles-stubs/include -DHWCAP2_AES=1 -DHWCAP2_SHA1=4 -DHWCAP2_SHA2=8 -DHWCAP2_CRC32=16"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-L/opt/gles-stubs/lib -static-libstdc++ -static-libgcc"
