export CFLAGS="-I$stubs/inc -DEGL_NO_X11 -DGL_NV_path_rendering -I/usr/include/arm-linux-gnueabihf"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-L$stubs/lib -L/usr/lib/arm-linux-gnueabihf"
